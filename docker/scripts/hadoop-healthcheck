#!/usr/bin/env bash
set -euo pipefail

hdfs dfs -test -d /user/student
yarn node -list -all 2>/dev/null | grep -Eq '[[:space:]]RUNNING[[:space:]]'
curl --fail --silent --show-error http://localhost:9870/ >/dev/null
curl --fail --silent --show-error http://localhost:8088/ >/dev/null
curl --fail --silent --show-error http://localhost:19888/ >/dev/null
